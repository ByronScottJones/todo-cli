# Top-most EditorConfig. `dotnet format` treats these rules as authoritative.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{csproj,props,targets,yml,yaml,json,jsonc}]
indent_size = 2

[*.md]
indent_size = 2

# Makefile recipes require literal tabs.
[{Makefile,Makefile.*}]
indent_style = tab

[*.cs]
csharp_style_namespace_declarations = file_scoped:suggestion
dotnet_sort_system_directives_first = true
